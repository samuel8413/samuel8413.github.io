---
import { createHash } from 'node:crypto';
import Seo from '../components/seo/Seo.astro';
import '../styles/global.css';

/**
 * Document shell. Owns everything that is true for every page: language,
 * viewport, theme bootstrapping, metadata and the CSP registration of the one
 * inline script we ship.
 */
interface Props {
  title: string;
  description: string;
  image?: { url: string; width: number; height: number; alt: string };
  author?: string;
  lang?: string;
  noindex?: boolean;
}

const { title, description, image, author, lang = 'en', noindex = false } = Astro.props;

/**
 * Applies a stored theme before first paint to avoid a flash. It has to be
 * inline (a bundled module would run too late), so it is not hashed by Astro
 * automatically; we hash it here and register it with the CSP.
 */
const themeBootScript =
  "try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}";
const themeBootHash =
  `sha256-${createHash('sha256').update(themeBootScript).digest('base64')}` as const;
Astro.csp?.insertScriptHash(themeBootHash);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
    {author && <meta name="author" content={author} />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafaf9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0a09" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <script is:inline set:html={themeBootScript}></script>
    <Seo title={title} description={description} image={image} noindex={noindex} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
