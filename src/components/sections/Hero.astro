---
import { Picture } from 'astro:assets';
import headshot from '../../assets/headshot.jpg';
import type { Contact, Identity } from '../../domain/model.ts';
import ExternalLink from '../ui/ExternalLink.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  identity: Identity;
  contact: Contact;
}

const { identity, contact } = Astro.props;
const pitch = identity.summaryParagraphs[0];
---

<section id="top" class="hero" aria-labelledby="hero-name">
  <div class="container grid">
    <div class="copy">
      {identity.location && (
        <p class="location">
          <Icon name="map-pin" size={16} />
          {identity.location}
        </p>
      )}
      <h1 id="hero-name">{identity.name}</h1>
      <p class="headline">{identity.headline}</p>
      {pitch && <p class="pitch prose">{pitch}</p>}

      <ul class="actions no-print" role="list" aria-label="Contact links">
        {contact.linkedin && (
          <li>
            <ExternalLink href={contact.linkedin} class="button primary">
              <Icon name="linkedin" size={18} /> LinkedIn
            </ExternalLink>
          </li>
        )}
        {contact.github && (
          <li>
            <ExternalLink href={contact.github} class="button">
              <Icon name="github" size={18} /> GitHub
            </ExternalLink>
          </li>
        )}
        {contact.email && (
          <li>
            <a href={`mailto:${contact.email}`} class="button">
              <Icon name="mail" size={18} /> Email
            </a>
          </li>
        )}
      </ul>
    </div>

    <div class="portrait">
      <Picture
        src={headshot}
        alt={`Portrait of ${identity.name}`}
        width={280}
        height={280}
        widths={[160, 280, 420, 560]}
        sizes="(max-width: 40rem) 160px, 280px"
        formats={['avif', 'webp']}
        layout="constrained"
        priority
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-8);
    background:
      radial-gradient(60rem 30rem at 85% -10%, var(--color-accent-soft), transparent 60%),
      var(--color-bg);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-7);
    align-items: center;
  }

  .location {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-block-end: var(--space-3);
  }

  h1 {
    font-size: var(--text-3xl);
    letter-spacing: -0.02em;
  }

  .headline {
    margin-block-start: var(--space-3);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
    max-width: 40ch;
  }

  .pitch {
    margin-block-start: var(--space-5);
    font-size: var(--text-lg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  .actions :global(.button) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
    transition:
      background var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .actions :global(.button:hover) {
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .actions :global(.button.primary) {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .actions :global(.button.primary:hover) {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
  }

  .portrait :global(img) {
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md);
    outline: 4px solid var(--color-surface);
  }

  @media (max-width: 40rem) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .portrait {
      order: -1;
    }

    .portrait :global(img) {
      width: 160px;
      height: 160px;
    }
  }

  @media print {
    .hero {
      padding-block: 0 var(--space-4);
    }

    .grid {
      grid-template-columns: 1fr auto;
    }

    .portrait :global(img) {
      width: 96px;
      height: 96px;
      box-shadow: none;
      outline: none;
    }
  }
</style>
