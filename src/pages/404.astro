---
import { profile, siteConfig } from '../data/profile.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = siteConfig.site.titleTemplate.replace('%s', 'Page not found');
const home = import.meta.env.BASE_URL;
---

<BaseLayout
  title={title}
  description={`This page does not exist on ${profile.identity.name}'s site.`}
>
  <main id="main" class="container">
    <p class="code" aria-hidden="true">
      404
    </p>
    <h1>Page not found</h1>
    <p>The address may be mistyped, or the page moved.</p>
    <p>
      <a href={home}>Back to the profile</a>
    </p>
  </main>
</BaseLayout>

<style>
  main {
    min-height: 70dvh;
    display: grid;
    align-content: center;
    gap: var(--space-3);
  }

  .code {
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: -0.03em;
  }

  h1 {
    font-size: var(--text-2xl);
  }
</style>
